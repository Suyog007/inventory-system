// inventory-ags database schema
// Slice 1-2 (Foundation + Shopify). See docs/plan.md for context.
// Later slice tables (CertLookup, PricingRule, ScanResult, etc.) are designed
// in docs/plan.md but intentionally NOT created here until their slice is built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL configured in prisma.config.ts (Prisma 7+)
}

// =========================================================
// Auth & Users
// =========================================================

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(STAFF)

  invitedById  String?
  invitedBy    User?  @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("UserInvites")

  outboxItems OutboxItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

// =========================================================
// Channels
// =========================================================

enum Channel {
  SHOPIFY
  EBAY
  TIKTOK
  WHATNOT
  SQUARE
  WALMART
  LOUPE
  MYCARDPOST
  MASCOTNETWORK
  MERCURY
}

model ChannelConnection {
  id                String    @id @default(cuid())
  channel           Channel
  shopDomain        String? // For Shopify et al.
  externalAccountId String? // For eBay et al. (seller ID)
  accessToken       String    @db.Text // encrypted at rest
  refreshToken      String?   @db.Text // encrypted; for OAuth providers that issue them
  scopes            String    @db.Text // comma-separated
  metadata          Json? // per-channel extras
  installedAt       DateTime  @default(now())
  lastWebhookAt     DateTime?

  listings      Listing[]
  webhookEvents WebhookEvent[]
  outboxItems   OutboxItem[]
  syncRuns      SyncRun[]
  orders        Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([channel, shopDomain])
  @@index([channel])
  @@index([deletedAt])
}

// =========================================================
// Catalog (Card / Variant / Image / Tag)
// =========================================================

enum CardStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ParseSource {
  TITLE_ONLY
  TEMPLATED_DESCRIPTION
  MANUAL_OVERRIDE
  CERT_LOOKUP
  SCANNER
  IMPORT_UNPARSED
}

model Card {
  id              String      @id @default(cuid())
  title           String
  descriptionHtml String?     @db.Text
  vendor          String?
  productType     String? // DEPRECATED: replaced by categoryId. Kept one migration cycle for safe rollback.
  status          CardStatus  @default(ACTIVE) // DEPRECATED: publish/delist is now driven by Listing rows + soft-delete.
  parseSource     ParseSource @default(IMPORT_UNPARSED)

  // Card-specific facts (channel-agnostic)
  player      String?
  setName     String?
  year        Int?
  cardNumber  String?
  variantName String? // "Parallel/Variety" in UI (Holo, Refractor, etc.); model name Variant is taken by the inventory row.
  grader      String? // PSA, BGS, CGC, SGC, MBA
  grade       Decimal? @db.Decimal(4, 1) // e.g. 10.0, 9.5
  certNumber  String?
  sport       String?
  league      String?
  team        String?
  condition   String? // For ungraded cards (Mint, NM, etc.)

  // Extended catalog fields (added post-Slice-2 client feedback)
  manufacturer            String? // e.g. Panini, Topps, Upper Deck
  autographAuthentication String? // e.g. PSA/DNA, JSA, Beckett
  autographGrade          Decimal? @db.Decimal(4, 1) // grade of the auto specifically
  population              Int? // total pop at this grader/grade
  populationHigher        Int? // number graded higher; auto-populated later
  rarity                  String? // TCG-side (e.g. Rare, Ultra Rare, Secret Rare)
  tcgplayerId             String? // TCGplayer product ID
  game                    String? // TCG-side (Pokémon, Magic, Yu-Gi-Oh, etc.)

  // Shopify "Category" — distinct from productType. This is the GID
  // from Shopify's Standard Product Taxonomy (e.g. "gid://shopify/TaxonomyCategory/aa-2-1-12-3").
  // DEPRECATED: moved to Category.shopifyCategoryId (via categoryId FK).
  shopifyCategoryId String?

  // Category is the managed replacement for the free-text productType.
  // Templates + Shopify category mapping live on the Category row.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Pricing profile drives per-channel price adjustments on push.
  pricingProfileId String?
  pricingProfile   PricingProfile? @relation(fields: [pricingProfileId], references: [id], onDelete: SetNull)

  variants Variant[]
  images   Image[]
  cardTags CardTag[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([player])
  @@index([setName])
  @@index([year])
  @@index([grader, grade])
  @@index([certNumber])
  @@index([status])
  @@index([categoryId])
  @@index([pricingProfileId])
  @@index([deletedAt])
}

model Variant {
  id       String  @id @default(cuid())
  cardId   String
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name     String  @default("Default") // "Default", "Hobby Box", "Blaster Box", etc.
  sku      String? // fallback SKU when no category template + no cert-based auto-rule
  quantity Int     @default(0) // PHYSICAL inventory (canonical, channel-agnostic)
  position Int     @default(1)

  // Canonical listing price the user sets on the card. Per-channel prices are
  // derived by applying PricingProfileRule adjustments at push time.
  // Nullable-with-default because existing rows get backfilled from Listing.price
  // during the migration (see seed).
  listingPrice Decimal @default(0) @db.Decimal(12, 2)

  // Purchase / cost tracking (client feedback)
  purchaseDate  DateTime?
  purchasedFrom String?
  itemCost      Decimal?  @db.Decimal(12, 2) // pushed to Shopify inventoryItem.cost

  listings Listing[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([cardId])
  @@index([sku])
  @@index([deletedAt])
}

model Image {
  id             String  @id @default(cuid())
  cardId         String
  card           Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  url            String
  altText        String?
  position       Int     @default(0)
  shopifyImageId String? // Channel-specific ref (acceptable for Slice 1-2; refactor to ChannelImage join when Slice 5 adds eBay)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  cardTags CardTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Many-to-many join between Card and Tag
model CardTag {
  cardId String
  tagId  String
  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

// =========================================================
// Listings (per-channel state of a Variant)
// =========================================================

enum ListingStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  SOLD
  DELISTED
}

model Listing {
  id                  String            @id @default(cuid())
  variantId           String
  variant             Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  externalId          String // The channel's ID for the LISTING (e.g., variant GID on Shopify)
  externalParentId    String? // For channels with a parent product (Shopify product GID); null otherwise
  externalUrl         String?
  status              ListingStatus     @default(ACTIVE)
  price               Decimal           @db.Decimal(12, 2) // CHANNEL-specific price (last pushed) — computed from Variant.listingPrice + PricingProfileRule at push time
  compareAtPrice      Decimal?          @db.Decimal(12, 2)
  lastSyncedAt        DateTime          @default(now())
  // NOTE: no inventory field. Inventory is canonical on Variant.quantity.
  // If we ever need split-inventory-per-channel (rare), add optional quantityOverride here.

  // Per-channel template control. When useXTemplate is true (default), the outbox
  // renders the value from the category+channel Template row. When false, it uses
  // the stored xOverride text.
  useTitleTemplate       Boolean @default(true)
  useDescriptionTemplate Boolean @default(true)
  useSkuTemplate         Boolean @default(true)
  titleOverride          String?
  descriptionHtmlOverride String? @db.Text
  skuOverride            String?

  orderLines OrderLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([variantId, channelConnectionId])
  @@unique([channelConnectionId, externalId])
  @@index([status])
  @@index([deletedAt])
}

// =========================================================
// Sync infrastructure (webhook log, outbox, sync runs)
// =========================================================

model WebhookEvent {
  id                  String            @id @default(cuid())
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  topic               String // e.g., "products/update"
  externalEventId     String? // Channel-side event ID, used for idempotency
  payload             Json
  hmacValid           Boolean
  error               String? @db.Text
  receivedAt          DateTime  @default(now())
  processedAt         DateTime?

  @@unique([channelConnectionId, externalEventId])
  @@index([topic])
  @@index([processedAt])
}

enum OutboxOperation {
  CREATE_LISTING
  UPDATE_LISTING
  DELETE_LISTING
  UPDATE_VARIANT_PRICE
  UPDATE_VARIANT_INVENTORY
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxItem {
  id                  String            @id @default(cuid())
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  userId              String? // who initiated (null for system-generated)
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  operation           OutboxOperation
  targetType          String // e.g., "Listing", "Variant", "Card"
  targetId            String // local row id this acts on
  payload             Json
  status              OutboxStatus      @default(PENDING)
  attempts            Int               @default(0)
  lastError           String?           @db.Text
  scheduledFor        DateTime          @default(now())
  completedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([channelConnectionId])
}

enum SyncRunKind {
  IMPORT
  REFRESH
  RECONCILE
}

model SyncRun {
  id                  String            @id @default(cuid())
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  kind                SyncRunKind
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  productsAdded       Int               @default(0)
  productsUpdated     Int               @default(0)
  productsDeleted     Int               @default(0)
  errors              Json?

  @@index([channelConnectionId, kind, startedAt])
}

// =========================================================
// Orders (sales from any channel)
// =========================================================

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

model Order {
  id                  String            @id @default(cuid())
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  externalOrderId     String // e.g., "#1042"
  customerEmail       String?
  customerName        String?
  total               Decimal           @db.Decimal(12, 2)
  status              OrderStatus       @default(PENDING)
  placedAt            DateTime

  lines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelConnectionId, externalOrderId])
  @@index([placedAt])
  @@index([status])
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  quantity    Int      @default(1)
  priceAtSale Decimal  @db.Decimal(12, 2)
  titleAtSale String // snapshot title in case the Listing changes or is deleted

  @@index([orderId])
  @@index([listingId])
}

// =========================================================
// Category (managed replacement for free-text productType)
// =========================================================

model Category {
  id                String  @id @default(cuid())
  name              String  @unique
  shopifyCategoryId String? // Shopify Standard Product Taxonomy GID (gid://shopify/TaxonomyCategory/...)
  position          Int     @default(0)

  cards     Card[]
  templates Template[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

enum TemplateKind {
  TITLE
  DESCRIPTION
  SKU
}

// A Template is (category × channel × kind) → body. channel=null is the default
// that applies to any channel without an override. Bodies use {Token} syntax
// resolved at push time via src/lib/templates/render.ts.
model Template {
  id         String       @id @default(cuid())
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  channel    Channel? // null = default for all channels (unless overridden)
  kind       TemplateKind
  body       String       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite uniqueness: one default (channel=null) + optional per-channel overrides per kind.
  // Postgres treats NULLs as distinct so multi-null rows are technically allowed;
  // enforced in app layer instead.
  @@index([categoryId, channel, kind])
}

// =========================================================
// Pricing profiles + rules (per-channel adjustments)
// =========================================================

model PricingProfile {
  id              String  @id @default(cuid())
  name            String  @unique
  isDefault       Boolean @default(false)
  minOfferEnabled Boolean @default(false)
  minOfferPercent Int     @default(0) // negative: e.g. -15 = 85% floor for offers (eBay-side, not consumed yet)

  cards Card[]
  rules PricingProfileRule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model PricingProfileRule {
  id                  String         @id @default(cuid())
  profileId           String
  profile             PricingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  channel             Channel
  priceAdjustPercent  Int            @default(0) // e.g. +15 = list at 115% on that channel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, channel])
}
